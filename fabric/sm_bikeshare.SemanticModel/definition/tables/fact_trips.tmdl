table fact_trips
	lineageTag: 9f4efc1a-e322-42cc-a838-97e293ff9a57
	sourceLineageTag: [gold].[fact_trips]

	measure 'Total Trips' = COUNTROWS(fact_trips)
		formatString: 0
		lineageTag: 23953850-c359-4a61-aa48-1cd5e656cc84

		changedProperty = Name

		changedProperty = FormatString

	measure 'Trips by End Station' =
			
			CALCULATE([Total Trips], USERELATIONSHIP(fact_trips[end_station_key], dim_station[station_key]))
		formatString: 0
		lineageTag: 9f0efe1a-5c5a-4da3-933c-a3c95bc59e71

		changedProperty = Name

	measure 'Trips per Hour' = DIVIDE([Total Trips], DISTINCTCOUNT(fact_trips[weather_key]))
		lineageTag: 6e1f7ec4-794e-4303-81a3-7344897a2dbc

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Member Share %' =
			
			DIVIDE(
			    CALCULATE(COUNTROWS(fact_trips), fact_trips[user_type] = "member"),
			    COUNTROWS(fact_trips)
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 62e7eba8-d8f8-492a-bee3-d0911758e3eb

		changedProperty = Name

		changedProperty = FormatString

	measure 'Rain Drop %' =
			
			VAR _dry = CALCULATE([Trips per Hour], dim_weather[weather_label] = "Dry")
			VAR _rain = CALCULATE([Trips per Hour], dim_weather[weather_label] = "Rain/Snow")
			RETURN DIVIDE(_dry - _rain, _dry)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c1222762-7f36-4c49-a43c-ff24cc3527cf

		changedProperty = Name

		changedProperty = FormatString

	measure 'Dry Trips per Hour' =
			
			CALCULATE([Trips per Hour], dim_weather[weather_label] = "Dry")
		lineageTag: 56391878-f27b-4e41-8654-e48b4d62f0f7

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rain Trips per Hour' =
			
			CALCULATE([Trips per Hour], dim_weather[weather_label] = "Rain/Snow")
		lineageTag: 3579a338-259f-4b74-b01d-98b0df8d9e6b

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

