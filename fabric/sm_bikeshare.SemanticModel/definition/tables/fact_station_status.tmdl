table fact_station_status
	lineageTag: d1788320-90d7-4aab-a184-0639e8c00e94
	sourceLineageTag: [gold].[fact_station_status]

	measure 'Empty Rate' = DIVIDE(SUM(fact_station_status[is_empty]), COUNTROWS(fact_station_status))
		lineageTag: acd075ae-60bf-4c79-92da-9c5502660d97

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Full Rate' = DIVIDE(SUM(fact_station_status[is_full]), COUNTROWS(fact_station_status))
		lineageTag: defe26e8-0a43-451e-abb5-87bda04c3335

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Latest Snapshot' = CALCULATE(MAX(fact_station_status[snapshot_ts]), ALL(fact_station_status))
		formatString: General Date
		lineageTag: c2c3a884-e87f-45c8-bd4a-f6c1aa65611b

		changedProperty = Name

	measure 'Empty Stations Now' =
			
			VAR latest = [Latest Snapshot]
			RETURN CALCULATE(SUM(fact_station_status[is_empty]), fact_station_status[snapshot_ts] = latest)
		formatString: 0
		lineageTag: dc91551d-75cd-4834-b162-32a6726cbe05

		changedProperty = Name

	measure 'Empty Active Stations Now' =
			
			VAR latest = [Latest Snapshot]
			RETURN CALCULATE(
			    SUM(fact_station_status[is_empty]),
			    fact_station_status[snapshot_ts] = latest,
			    fact_station_status[is_renting] = 1,
			    fact_station_status[is_installed] = 1
			)
		formatString: 0
		lineageTag: 95097cad-e03a-459b-aaf8-8b2684cca780

		changedProperty = Name

	measure 'Full Active Stations Now' =
			
			VAR latest = [Latest Snapshot]
			RETURN CALCULATE(
			    SUM(fact_station_status[is_full]),
			    fact_station_status[snapshot_ts] = latest,
			    fact_station_status[is_renting] = 1,
			    fact_station_status[is_installed] = 1
			)
		formatString: 0
		lineageTag: 727cb2be-fd8d-4c70-bb51-983a0a120822

		changedProperty = Name

	measure 'Empty Rate (Active)' =
			
			DIVIDE(
			    CALCULATE(
			        SUM(fact_station_status[is_empty]),
			        fact_station_status[is_renting] = 1,
			        fact_station_status[is_installed] = 1
			    ),
			    CALCULATE(
			        COUNTROWS(fact_station_status),
			        fact_station_status[is_renting] = 1,
			        fact_station_status[is_installed] = 1
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 42cad647-c0e4-405a-8369-45acc8c748f9

		changedProperty = Name

		changedProperty = FormatString

	measure 'Full Rate (Active)' =
			
			DIVIDE(
			    CALCULATE(
			        SUM(fact_station_status[is_full]),
			        fact_station_status[is_renting] = 1,
			        fact_station_status[is_installed] = 1
			    ),
			    CALCULATE(
			        COUNTROWS(fact_station_status),
			        fact_station_status[is_renting] = 1,
			        fact_station_status[is_installed] = 1
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 773d45ef-5511-4c6b-85b3-2b276977b2f1

		changedProperty = Name

		changedProperty = IsHidden

		changedProperty = FormatString

	measure 'Empty Rate Now (Active)' =
			
			VAR _latest = CALCULATE(MAX(fact_station_status[snapshot_ts]), ALL(fact_station_status))
			VAR _active = CALCULATE(COUNTROWS(fact_station_status), fact_station_status[snapshot_ts] = _latest, fact_station_status[is_renting] = 1, fact_station_status[is_installed] = 1)
			VAR _empty = CALCULATE(SUM(fact_station_status[is_empty]), fact_station_status[snapshot_ts] = _latest, fact_station_status[is_renting] = 1, fact_station_status[is_installed] = 1)
			RETURN DIVIDE(_empty, _active)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 76db26da-59b1-424b-8782-da92e079a229

		changedProperty = Name

		changedProperty = FormatString

	measure 'Full Rate Now (Active)' =
			
			VAR _latest = CALCULATE(MAX(fact_station_status[snapshot_ts]), ALL(fact_station_status))
			VAR _active = CALCULATE(COUNTROWS(fact_station_status), fact_station_status[snapshot_ts] = _latest, fact_station_status[is_renting] = 1, fact_station_status[is_installed] = 1)
			VAR _full = CALCULATE(SUM(fact_station_status[is_full]), fact_station_status[snapshot_ts] = _latest, fact_station_status[is_renting] = 1, fact_station_status[is_installed] = 1)
			RETURN DIVIDE(_full, _active)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7781356a-8c27-4b6f-8653-ce58f9e539f2

		changedProperty = Name

		changedProperty = FormatString

	measure 'Is Empty Active Now' =
			
			VAR _latest = CALCULATE(MAX(fact_station_status[snapshot_ts]), ALL(fact_station_status))
			RETURN
			CALCULATE(
			    SUM(fact_station_status[is_empty]),
			    fact_station_status[snapshot_ts] = _latest,
			    fact_station_status[is_renting] = 1,
			    fact_station_status[is_installed] = 1
			)
		formatString: 0
		lineageTag: aa9fc07f-ea9d-4c3d-a009-0b8d61c52a75

		changedProperty = Name

	measure 'Empty Snapshots (Active)' =
			
			CALCULATE(
			    SUM(fact_station_status[is_empty]),
			    fact_station_status[is_renting] = 1,
			    fact_station_status[is_installed] = 1
			)
		formatString: 0
		lineageTag: 54611418-a4eb-4d0d-8c16-36fc3c2ca9f3

		changedProperty = Name

