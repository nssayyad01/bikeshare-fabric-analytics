table fact_rider_feedback
	lineageTag: e9f16086-6bd0-497e-93be-fe7bdd67e789
	sourceLineageTag: [gold].[fact_rider_feedback]

	measure 'Total Feedback' = ```
			DISTINCTCOUNT(fact_rider_feedback[feedback_doc_id]) 
			```
		formatString: 0
		lineageTag: 9fc848e3-1a19-47aa-a884-ca06f719c1d8

		changedProperty = Name

	measure 'Negative Share %' =
			
			DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT(fact_rider_feedback[feedback_doc_id]),
			        fact_rider_feedback[predicted_sentiment] = "negative"
			    ),
			    DISTINCTCOUNT(fact_rider_feedback[feedback_doc_id])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 419518b7-974c-412c-ae26-05cca8250a4d

		changedProperty = Name

		changedProperty = FormatString

